{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "titan-hotspot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "titan-hotspot-db",
