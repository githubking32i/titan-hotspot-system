{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "titan-hotspot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "titan-hotspot-db",
      "database_id": "YOUR_D1_DATABASE_ID_HERE"
    }
  ],
  "vars": {
    "ADMIN_TOKEN": "YOUR_ADMIN_SECRET_TOKEN",
    "ROUTER_SECRET": "YOUR_ROUTER_SECRET_TOKEN",
    "SMS_SECRET": "YOUR_SMS_SECRET_TOKEN"
  }
}
